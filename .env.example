# AI / LLM Multi-Provider API Configuration
# Supported providers: 'groq', 'gemini', 'mistral', 'nvidia', 'openai'
# If unset or if network fails, system automatically cascades or uses offline smart engine.
AI_PROVIDER=groq

# 1. Groq Cloud (Recommended for Ultra-Fast Inference)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Mistral AI
# Obtain from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# 3. NVIDIA NIM Cloud
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=google/gemma-3-12b-it

# 4. Google Gemini
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 5. OpenAI (Alternative)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
